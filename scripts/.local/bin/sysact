#!/usr/bin/env bash

# --- 1. CONFIG ---
WM="dwm"
STATUSBAR="dwmblocks"

# Hàm lấy PID của DWM an toàn trên NixOS
get_wm_pid() {
    # pgrep -x tìm chính xác tên process, an toàn hơn pstree
    pgrep -x "$WM" | head -n 1
}

# Hàm khóa máy & xử lý âm thanh
lock() {
    # Tạm dừng nhạc nếu có mpc/mpv
    command -v mpc >/dev/null && mpc pause
    command -v pauseallmpv >/dev/null && pauseallmpv

    # Mute âm thanh (Dùng 1 để force mute, tránh toggle nhầm)
    if command -v wpctl >/dev/null; then
        wpctl set-mute @DEFAULT_AUDIO_SINK@ 1
        # Gửi tín hiệu update icon volume (Signal 11 của bạn)
        pkill -RTMIN+11 "$STATUSBAR"
    fi

    # Khóa màn hình (Chạy blocking)
    slock

    # Mở lại âm thanh sau khi unlock
    if command -v wpctl >/dev/null; then
        wpctl set-mute @DEFAULT_AUDIO_SINK@ 0
        pkill -RTMIN+11 "$STATUSBAR"
    fi
}

# --- 2. MENU DEFINITION ---
# Dùng chuỗi đơn giản để tránh lỗi cú pháp
# Format: "Icon Tên|Lệnh"
options="🔒 Lock
🚪 Leave $WM
♻️ Renew $WM
🐻 Hibernate
💤 Sleep
🔃 Reboot
🛑 Shutdown
📺 Display Off"

# --- 3. HIỂN THỊ DMENU ---
# -i: Case insensitive
# -p: Prompt
selected="$(echo -e "$options" | dmenu -i -p 'System:')"

# --- 4. XỬ LÝ LỆNH ---
case "$selected" in
    *'Lock')
        lock ;;
    *'Leave'*)
        ka-exit ;;
    *'Renew'*)
        kill -HUP "$(get_wm_pid)" ;;
    *'Hibernate')
        slock &
        if command -v systemctl >/dev/null 2>&1; then systemctl hibernate
        elif command -v loginctl >/dev/null 2>&1; then loginctl hibernate
        elif command -v ZZZ >/dev/null 2>&1; then sudo ZZZ
        fi ;;
    *'Sleep')
        slock &
        if command -v systemctl >/dev/null 2>&1; then systemctl suspend
        elif command -v loginctl >/dev/null 2>&1; then loginctl suspend
        elif command -v zzz >/dev/null 2>&1; then sudo zzz
        fi ;;
    *'Reboot')
        if command -v systemctl >/dev/null 2>&1; then systemctl reboot
        elif command -v loginctl >/dev/null 2>&1; then loginctl reboot
        else sudo reboot; fi ;;
    *'Shutdown')
        if command -v systemctl >/dev/null 2>&1; then systemctl poweroff
        elif command -v loginctl >/dev/null 2>&1; then loginctl poweroff
        else sudo poweroff; fi ;;
    *'Display'*)
        xset dpms force off ;;
esac